{
  "name": "notification-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:cluster": "node dist/main-cluster.js",
    "dev": "nodemon",
    "start:sms-worker": "ts-node src/sms.worker.main.ts",
    "start:email-worker": "ts-node src/email.worker.main.ts",
    "start:whatsapp-worker": "ts-node src/whatsapp.worker.main.ts",
    "start:sms-worker:prod": "node dist/sms.worker.main.js",
    "start:email-worker:prod": "node dist/email.worker.main.js",
    "start:whatsapp-worker:prod": "node dist/whatsapp.worker.main.js",
    "start:all-workers": "concurrently -n SMS,EMAIL,WHATSAPP -c blue,green,magenta \"npm run start:sms-worker\" \"npm run start:email-worker\" \"npm run start:whatsapp-worker\"",
    "start:all-workers:prod": "concurrently -n SMS,EMAIL,WHATSAPP -c blue,green,magenta \"npm run start:sms-worker:prod\" \"npm run start:email-worker:prod\" \"npm run start:whatsapp-worker:prod\""
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@sendgrid/mail": "^8.1.6",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "amqplib": "^0.10.9",
    "aws-sdk": "^2.1360.0",
    "axios": "^1.13.1",
    "body-parser": "^2.2.0",
    "bottleneck": "^2.19.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^8.2.1",
    "handlebars": "^4.7.7",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mailersend": "^2.6.0",
    "node-fetch": "^3.3.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.0",
    "postmark": "^4.0.5",
    "prom-client": "^14.2.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/csurf": "^1.11.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
